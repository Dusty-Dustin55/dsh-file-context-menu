{
  "name": "dsh-file-context-menu",
  "version": "0.3.9",
  "type": "module",
  "description": "Right-click file references and web links in the DSH chat: reference, copy, preview, open with default or chosen app, reveal, or save a copy.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "author": "Dusty-Dustin55",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "file",
    "context-menu",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dusty-Dustin55/dsh-file-context-menu.git"
  },
  "homepage": "https://github.com/Dusty-Dustin55/dsh-file-context-menu#readme",
  "bugs": {
    "url": "https://github.com/Dusty-Dustin55/dsh-file-context-menu/issues"
  },
  "engines": {
    "dsh": "^0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
